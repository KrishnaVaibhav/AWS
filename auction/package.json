{
  "name": "auction",
  "private": true,
  "type": "module",
  "description": "Tests only. The functions ship without node_modules: the Lambda Node.js runtime provides the AWS SDK.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "node scripts/dev-server.mjs",
    "dynamodb": "docker run --rm -d -p 8000:8000 --name auction-ddb amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.700.0"
  }
}
